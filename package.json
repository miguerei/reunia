{
  "name": "reunia",
  "productName": "ReunIA",
  "version": "0.3.2",
  "description": "Grabador de reuniones con IA. Registra audio del PC y llamadas (Google Meet, Zoom, etc.), transcribe con Whisper y genera informes inteligentes con resúmenes, insights clave, asistentes, recomendaciones, consejos y to-do list. 100% local-first con opción de Ollama.",
  "author": "Miguel Reina",
  "license": "MIT",
  "homepage": "https://github.com/miguerei/reunia",
  "repository": {
    "type": "git",
    "url": "https://github.com/miguerei/reunia.git"
  },
  "bugs": {
    "url": "https://github.com/miguerei/reunia/issues"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "electron:dev": "npx electron dist-electron/main.js",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac --x64 --arm64",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win"
  },
  "build": {
    "appId": "com.miguerei.reunia",
    "productName": "ReunIA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "miguerei",
      "repo": "reunia",
      "private": false,
      "releaseType": "release"
    }
  },
  "overrides": {
    "dompurify": ">=3.2.4"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "docx": "^8.5.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.18.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "openai": "^4.104.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.3",
    "wavesurfer.js": "^7.9.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^5.4.19"
  }
}
